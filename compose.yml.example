###############################################################################
# RookHub full-stack deployment
#
# 1. Clone:           git clone https://github.com/kahalm/rookhub.git && cd rookhub
# 2. Copy this file:  cp compose.yml.example compose.yml
# 3. Create .env (see below) and adjust values
# 4. Start:           docker compose up -d
#
# Required .env variables (no defaults – all must be set explicitly):
#   MARIADB_ROOT_PASSWORD=
#   DB_HOST=
#   DB_PORT=
#   DB_EXTERNAL_PORT=
#   CRAWLER_DB_NAME=
#   CRAWLER_DB_USER=
#   CRAWLER_DB_PASSWORD=
#   ROOKHUB_DB_NAME=
#   ROOKHUB_DB_USER=
#   ROOKHUB_DB_PASSWORD=
#   JWT_KEY=<min-32-char-secret-for-jwt-signing>
#   JWT_ISSUER=
#   JWT_AUDIENCE=
#   CRAWLER_API_KEY=
#   FRONTEND_PORT=
#   API_PORT=
#   DB_DATA_PATH=              (named volume, or host path like /data/mariadb)
#   INIT_DB_PATH=
#   ADMIN_USERNAME=
#   ADMIN_PASSWORD=
#
# Optional .env variables (feature stays OFF when unset – see comments below):
#   ENCRYPTION_KEY=            PFLICHT: AES key for the stored Chessable bearer (leer = Schein-Verschlüsselung!)
#   CHESSABLE_API_URL=         piratechess API, default http://piratechess-api:8080
#   CHESSABLE_SERVICE_KEY=
#   DISCORD_LINK_SECRET=       required for linking Discord accounts
#   APP_BASE_URL=              public frontend URL, used in e-mail links (password reset)
#   EMAIL_SMTP_HOST/PORT/USER/PASSWORD/FROM_ADDRESS/FROM_NAME/USE_STARTTLS
#   ELASTICSEARCH_URL=         Serilog sink; unset = file/console logging only
#   SCHACH_BOT_WEBHOOK_URL/SCHACH_BOT_WEBHOOK_SECRET/SCHACH_BOT_STATS_SECRET
#   ANTHROPIC_API_KEY=         puzzle hint generation
#
# Ports:
#   ${FRONTEND_PORT}    -> Frontend (nginx)
#   ${API_PORT}          -> RookHub API
#   ${DB_EXTERNAL_PORT}  -> MariaDB
###############################################################################

services:

  # ── Shared MariaDB ─────────────────────────────────────────────────────────
  mariadb:
    image: mariadb:11
    container_name: rookhub-mariadb
    restart: unless-stopped
    environment:
      MARIADB_ROOT_PASSWORD: ${MARIADB_ROOT_PASSWORD}
      CRAWLER_DB_NAME: ${CRAWLER_DB_NAME}
      CRAWLER_DB_USER: ${CRAWLER_DB_USER}
      CRAWLER_DB_PASSWORD: ${CRAWLER_DB_PASSWORD}
      ROOKHUB_DB_NAME: ${ROOKHUB_DB_NAME}
      ROOKHUB_DB_USER: ${ROOKHUB_DB_USER}
      ROOKHUB_DB_PASSWORD: ${ROOKHUB_DB_PASSWORD}
    ports:
      - "${DB_EXTERNAL_PORT}:3306"
    volumes:
      - ${DB_DATA_PATH}:/var/lib/mysql
      - ${INIT_DB_PATH}:/docker-entrypoint-initdb.d/init-db.sh:ro
    command: --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ── ChessResults Crawler ──────────────────────────────────────────────────
  crawler:
    image: ghcr.io/kahalm/rookhub-crawler:latest
    container_name: rookhub-crawler
    restart: unless-stopped
    depends_on:
      mariadb:
        condition: service_healthy
    environment:
      ConnectionStrings__DefaultConnection: "Server=${DB_HOST};Port=${DB_PORT};Database=${CRAWLER_DB_NAME};User=${CRAWLER_DB_USER};Password=${CRAWLER_DB_PASSWORD};"
      API_KEY: ${CRAWLER_API_KEY}
      ASPNETCORE_ENVIRONMENT: Production

  # ── RookHub API ────────────────────────────────────────────────────────────
  api:
    image: ghcr.io/kahalm/rookhub-api:latest
    container_name: rookhub-api
    restart: unless-stopped
    ports:
      - "${API_PORT}:8080"
    depends_on:
      mariadb:
        condition: service_healthy
      crawler:
        condition: service_started
    environment:
      ConnectionStrings__DefaultConnection: "Server=${DB_HOST};Port=${DB_PORT};Database=${ROOKHUB_DB_NAME};User=${ROOKHUB_DB_USER};Password=${ROOKHUB_DB_PASSWORD};"
      Jwt__Key: ${JWT_KEY:?JWT_KEY must be set}
      Jwt__Issuer: ${JWT_ISSUER}
      Jwt__Audience: ${JWT_AUDIENCE}
      Crawler__BaseUrl: http://crawler:8080
      Crawler__ApiKey: ${CRAWLER_API_KEY}
      ADMIN_USERNAME: ${ADMIN_USERNAME}
      ADMIN_PASSWORD: ${ADMIN_PASSWORD}
      ASPNETCORE_ENVIRONMENT: Production
      # Optional – leer lassen schaltet das jeweilige Feature still ab.
      Discord__LinkSecret: ${DISCORD_LINK_SECRET:-}
      App__BaseUrl: ${APP_BASE_URL:-}
      Email__SmtpHost: ${EMAIL_SMTP_HOST:-}
      Email__SmtpPort: ${EMAIL_SMTP_PORT:-587}
      Email__SmtpUser: ${EMAIL_SMTP_USER:-}
      Email__SmtpPassword: ${EMAIL_SMTP_PASSWORD:-}
      Email__FromAddress: ${EMAIL_FROM_ADDRESS:-}
      Email__FromName: ${EMAIL_FROM_NAME:-RookHub}
      Email__UseStartTls: ${EMAIL_USE_STARTTLS:-true}
      Chessable__ApiUrl: ${CHESSABLE_API_URL:-http://piratechess-api:8080}
      Chessable__ServiceKey: ${CHESSABLE_SERVICE_KEY:-}
      # PFLICHT, sobald der Chessable-Import genutzt wird: ein LEERER Wert wäre kein
      # "Feature aus", sondern eine Schein-Verschlüsselung mit dem öffentlich bekannten
      # Fixschlüssel SHA256("") — deshalb bricht der Start hier bewusst ab.
      Encryption__Key: ${ENCRYPTION_KEY:?ENCRYPTION_KEY muss gesetzt sein (verschlüsselt den gespeicherten Chessable-Bearer)}
      Elasticsearch__Url: ${ELASTICSEARCH_URL:-}
      SchachBot__WebhookUrl: ${SCHACH_BOT_WEBHOOK_URL:-}
      SchachBot__WebhookSecret: ${SCHACH_BOT_WEBHOOK_SECRET:-}
      SchachBot__StatsSecret: ${SCHACH_BOT_STATS_SECRET:-}
      Anthropic__ApiKey: ${ANTHROPIC_API_KEY:-}
      # Admin-Tab „CI / Actions": GitHub-PAT (actions:read) + Push-Modell. Leer -> Tab/Meldungen aus;
      # die CI-Endpoints antworten ohne Secret mit 401 (fail-closed).
      GitHub__Token: ${GITHUB_TOKEN:-}
      CI__BuildReportSecret: ${CI_BUILD_REPORT_SECRET:-}
      CI__GithubWebhookSecret: ${CI_GITHUB_WEBHOOK_SECRET:-}
      # Link auf die Log-Visualisierung im Admin-Header. Leer -> kein Link.
      Kibana__Url: ${KIBANA_URL:-}
      # Web-Push (VAPID). Alle drei leer -> Push deaktiviert, Panel zeigt „nicht verfügbar".
      # Keypair erzeugen: npx web-push generate-vapid-keys
      WebPush__Subject: ${WEBPUSH_SUBJECT:-}
      WebPush__PublicKey: ${WEBPUSH_PUBLIC_KEY:-}
      WebPush__PrivateKey: ${WEBPUSH_PRIVATE_KEY:-}
    volumes:
      # PFLICHT: ohne persistentes /keys haelt ASP.NET die DataProtection-Keys nur im
      # Speicher — jeder Container-Neustart entwertet Reset-Links/geschuetzte Payloads.
      - dataprotection-keys:/keys
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:8080/health || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 40s

  # ── Frontend (Angular + nginx) ─────────────────────────────────────────────
  rookhub:
    image: ghcr.io/kahalm/rookhub-frontend:latest
    container_name: rookhub-frontend
    restart: unless-stopped
    ports:
      # FALLE: nginx laeuft im Image als non-root User und lauscht deshalb auf 8080,
      # NICHT auf 80 — ein 80er-Mapping ergibt einen tot wirkenden Stack.
      - "${FRONTEND_PORT}:8080"
    depends_on:
      - api
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

volumes:
  mariadb-data:
  dataprotection-keys:
