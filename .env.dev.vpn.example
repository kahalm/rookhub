# RookHub Dev-VPN Environment (pre-built ghcr.io Images)
# docker compose -f compose.dev.vpn.yml --env-file .env.dev.vpn up -d
#
# WICHTIG: Diese Variante laeuft typischerweise PARALLEL zum Prod-Stack
# (compose.vpn.yml / .env.vpn) auf demselben Host. Deshalb MUESSEN sich
# ALLE Host-Ports und ALLE Bind-Pfade vom Prod-Stack unterscheiden — sonst
# kollidieren die Host-Ports bzw. das ES-Datenverzeichnis (node.lock), und
# Elasticsearch/Kibana/API/Frontend starten nicht.

# Database (eigene Werte setzen!)
MARIADB_ROOT_PASSWORD=change_me
CRAWLER_DB_NAME=chessresults
CRAWLER_DB_USER=chessresults
CRAWLER_DB_PASSWORD=change_me
ROOKHUB_DB_NAME=rookhub
ROOKHUB_DB_USER=rookhub
ROOKHUB_DB_PASSWORD=change_me

# JWT-Signaturschluessel: PFLICHT, mind. 32 Zeichen, zufaellig erzeugen (z. B. openssl rand -base64 48).
# Bewusst LEER: ohne Wert bricht `docker compose` ab. Ein Platzhalter („change_me…", „your_…") laesst
# sich mit dem oeffentlichen Repo nachsignieren (RookHub meldet ihn beim Start auf Error).
JWT_KEY=
JWT_ISSUER=RookHub
JWT_AUDIENCE=RookHub

# Geteilte Anmeldung ueber beide Oberflaechen (RookHub + Turnierseite): gemeinsame
# Elterndomaene des Cookies. LEER = Funktion aus. Der NAME muss sich zwischen Dev und
# Prod unterscheiden, sonst ueberschreiben sich die Cookies auf derselben Domaene.
AUTH_SHARED_SESSION_DOMAIN=.oberschmid.homes
AUTH_SHARED_SESSION_COOKIE=rh_session_dev

# Admin-Account (wird beim Start angelegt/aktualisiert)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Crawler API Key (gleicher Wert in Crawler + RookHub API)
CRAWLER_API_KEY=change_me_to_a_secure_key

# Schluessel fuer den AES-verschluesselten Chessable-Bearer in der rookhub-DB. PFLICHT, zufaellig
# erzeugen (z. B. openssl rand -base64 32); leer bricht `docker compose` ab.
ENCRYPTION_KEY=

# Optional: Claude-API-Key — NUR fuer das Formular-Einlesen (Foto -> Partie, Kostenbremse im Code).
# Leer lassen = Feature inaktiv. Schluessel: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: EIGENER Schluessel fuer die Text-Aufrufe (Puzzle-Tipps, Kommentar-Uebersetzung). Bewusst getrennt:
# ohne diesen Schluessel laufen Tipps und Uebersetzung NICHT ueber den Konto-Schluessel oben (seit 2026-09-25).
ANTHROPIC_TEXT_API_KEY=

# Optional: GitHub-PAT (actions:read) fuer den Admin-Tab "CI / Actions". Leer -> Tab zeigt Hinweis.
GITHUB_TOKEN=

# Discord-Verknuepfung: HMAC-Secret fuer signierte Link-Tokens. MUSS exakt mit dem
# schach-bot (ROOKHUB_LINK_SECRET) uebereinstimmen. Leer lassen -> Feature inaktiv
# (ein Platzhalter „change_me…" ebenso). Eigener Zufallswert, NICHT derselbe wie unten.
DISCORD_LINK_SECRET=

# Schach-Bot Stats-Endpoint (/api/bot/player-progress): HMAC-Secret, mit dem der Bot
# den Trainings-/Puzzle-Fortschritt verknuepfter Spieler fuer den Motivations-DM liest.
# MUSS exakt mit dem schach-bot (ROOKHUB_STATS_SECRET) uebereinstimmen. Leer -> Endpoint aus
# (ein Platzhalter „change_me…" ebenso). Eigener Zufallswert, NICHT derselbe wie oben.
SCHACH_BOT_STATS_SECRET=

# Basis-URL des Frontends — fuer absolute Links in E-Mails (z.B. Passwort-Reset).
APP_BASE_URL=https://rookhub-dev.oberschmid.homes
# Eigene Domain der Turnierseite (Link-Vorschau geteilter Turnier-Links).
TURNIER_BASE_URL=https://turnier-dev.oberschmid.homes

# E-Mail-Versand (Passwort-Reset). EMAIL_SMTP_HOST leer lassen -> Versand deaktiviert
# (die Mail inkl. Reset-Link wird dann nur ins Log geschrieben). Port 587 = STARTTLS (empfohlen).
EMAIL_SMTP_HOST=login.trellmor.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=rookhub.dev@oberschmid.homes
EMAIL_SMTP_PASSWORD=change_me_smtp_password
EMAIL_FROM_ADDRESS=rookhub.dev@oberschmid.homes
EMAIL_FROM_NAME=RookHub
EMAIL_USE_STARTTLS=true

# App
ASPNETCORE_ENVIRONMENT=Development

# Host-Ports — dev-eigene Werte, NICHT mit Prod (5001/8086/3307/9202/5601) kollidieren!
API_PORT=5002
FRONTEND_PORT=8087
TURNIER_PORT=8094
KIDHUB_PORT=8097
LEAGUEHUB_PORT=8099
CLUBHUB_PORT=8101
DB_EXTERNAL_PORT=3309
ES_PORT=9201
KIBANA_PORT=5602
# Bind-Adressen der Ports (leer = Vorgabe): DB_BIND/API_BIND = 127.0.0.1 (nur der Host),
# FRONTEND_BIND = 0.0.0.0. Fuer DB und API nie 0.0.0.0 — dann auf allen Interfaces offen.
# HIER BEWUSST LEER (Vorlage). Auf DIESEM Host in der echten `.env`: API_BIND=10.24.13.6
# (der Dev-Bot geht auf 10.24.13.6:5002) und FRONTEND_BIND=10.24.13.6.
# RESTRISIKO dieser LAN-Adresse: Sie schliesst nur 192.168.1.2 und die Docker-Bridges; LAN
# 10.24.12.0/23 und geroutetes VPN 10.8.0.0/24 kommen genau darueber an und erreichen die Dev-API
# (mit Swagger-UI) weiter direkt, an NPM vorbei. Quell-Filter nur per iptables-Kette DOCKER-USER.
# Option: API_BIND=172.17.0.1 (docker0-Gateway = host.docker.internal), vorher den Dev-Bot umstellen.
# FALLE: Die Port-Kurzform bindet genau EINE Adresse — mit API_BIND=10.24.13.6 faellt 127.0.0.1
# weg. Die Skripte mit Vorgabe http://127.0.0.1:5002 (scripts/gazetteer-import.sh, directory-runs.sh,
# directory-backfill.sh, classify-directory.sh) brauchen dann die URL als erstes Argument,
# z. B. bash scripts/directory-runs.sh http://10.24.13.6:5002. Oder im api-Dienst einen zweiten
# Port-Eintrag "127.0.0.1:${API_PORT}:8080" ergaenzen.
DB_BIND=
API_BIND=
FRONTEND_BIND=
# Adressbereiche der App-Benutzer (init-db.sh, nur beim ersten Start); leer = die Docker-Bridge-Netze.
DB_APP_HOSTS=
# Admin-UI: Link zur passenden Kibana/ES-Konsole DIESER Umgebung (Admin-Header).
# Leer lassen -> Link bleibt versteckt. Dev-Kibana (eigener Port, NICHT 5601). Die URL braucht
# einen Kibana-Port auf 10.24.13.6: KIBANA_BIND (unten) auf DIESEM Host = 10.24.13.6, sonst
# lauscht Kibana nur auf 127.0.0.1 und der Link im Admin-Header ist tot.
KIBANA_URL=http://10.24.13.6:5602

# Bind-Pfade — dev-eigene Verzeichnisse, NICHT die Prod-Pfade (/srv/config/elasticsearch,
# /srv/config/rookhub/...) verwenden! Sonst teilen sich dev & prod das ES-Datadir.
DB_DATA_PATH=/srv/config/rookhub-dev/mariadb-data
ES_DATA_PATH=/srv/config/rookhub-dev/elasticsearch-data
INIT_DB_PATH=./init-db.sh

# VPN (Gluetun / WireGuard)
VPN_SERVICE_PROVIDER=airvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_private_key_here
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=10.x.x.x/32
SERVER_COUNTRIES=Germany
FIREWALL_VPN_INPUT_PORTS=8080

# --- CI-Push-Modell (Admin-Tab „CI / Actions") — optional; leer = Endpoints antworten 401 ---
CI_BUILD_REPORT_SECRET=
CI_GITHUB_WEBHOOK_SECRET=

# Elasticsearch laeuft ohne Security: wer den Port erreicht, darf LESEN UND SCHREIBEN (Indizes
# loeschen inbegriffen). ES_BIND waehlt die Adresse; leer/unset = 127.0.0.1 (nur der Host),
# fuer Leser im LAN die LAN-Adresse des Hosts — nie 0.0.0.0.
ES_BIND=

# Kibana laeuft ohne Login (xpack.security.enabled=false). Leer/unset = 127.0.0.1: der Port NUR
# auf dem Host (Zugang dann per SSH-Tunnel: ssh -L 5602:127.0.0.1:5602 <host>); fuer den
# LAN-Zugriff die LAN-Adresse des Hosts — nie 0.0.0.0 (im LAN ungeschuetzt lesbar).
# HIER BEWUSST LEER (Vorlage, wie in .env.vpn.example). Auf DIESEM Host lautet der Wert in der
# echten `.env`: KIBANA_BIND=10.24.13.6 — passend zu KIBANA_URL oben (gleiches Restrisiko wie
# bei API_BIND: LAN und VPN erreichen den Port, Quell-Filter nur per DOCKER-USER).
KIBANA_BIND=
