# RookHub VPN/Production Environment
# docker compose -f compose.vpn.yml --env-file .env.vpn up --build

# Database (in Produktion unbedingt aendern!)
MARIADB_ROOT_PASSWORD=change_me
CRAWLER_DB_NAME=chessresults
CRAWLER_DB_USER=chessresults
CRAWLER_DB_PASSWORD=change_me
ROOKHUB_DB_NAME=rookhub
ROOKHUB_DB_USER=rookhub
ROOKHUB_DB_PASSWORD=change_me
DB_EXTERNAL_PORT=3307      # nur auf DB_BIND veroeffentlicht (leer = 127.0.0.1, nur der Host)
# DB_BIND: nie 0.0.0.0 — dann erreicht jeder im LAN/VPN den Passwort-Login (MariaDB drosselt
# falsche Passwoerter nicht). Werkzeuge auf dem Host gehen ueber 127.0.0.1:3307.
DB_BIND=
# Adressbereiche der App-Benutzer (init-db.sh, nur beim ersten Start auf leerem Volume); leer =
# die Docker-Bridge-Netze (172.16.0.0/255.240.0.0 192.168.0.0/255.255.0.0). root gilt nur im
# Container (MARIADB_ROOT_HOST, Vorgabe localhost).
DB_APP_HOSTS=

# JWT-Signaturschluessel: PFLICHT, mind. 32 Zeichen, zufaellig erzeugen (z. B. openssl rand -base64 48).
# Bewusst LEER: ohne Wert bricht `docker compose` ab. Ein Platzhalter („change_me…", „your_…") laesst
# sich mit dem oeffentlichen Repo nachsignieren und wird in Production beim Start abgewiesen.
JWT_KEY=
JWT_ISSUER=RookHub
JWT_AUDIENCE=RookHub

# Geteilte Anmeldung ueber beide Oberflaechen (RookHub + Turnierseite): gemeinsame
# Elterndomaene des Cookies. LEER = Funktion aus. Der NAME muss sich zwischen Dev und
# Prod unterscheiden, sonst ueberschreiben sich die Cookies auf derselben Domaene.
AUTH_SHARED_SESSION_DOMAIN=.oberschmid.homes
AUTH_SHARED_SESSION_COOKIE=rh_session

# Admin-Account (wird beim Start angelegt/aktualisiert)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Crawler API Key (schuetzt Crawler-Endpoints, gleicher Wert in Crawler + RookHub API)
CRAWLER_API_KEY=change_me_to_a_secure_key

# Chessable-Integration (Backend in piratechess_docker, im Docker-Netz chessable-bridge).
# CHESSABLE_API_URL: interne URL der piratechess-API.
# CHESSABLE_SERVICE_KEY: MUSS exakt mit SERVICE_API_KEY aus piratechess_docker/.env uebereinstimmen.
#   Leer = RookHub schickt keinen Schluessel, der Chessable-Weg bleibt zu (fail-closed).
# ENCRYPTION_KEY: Schluessel, mit dem der per-User Chessable-Bearer AES-verschluesselt
# in der rookhub-DB liegt. Aenderung macht alle bestehenden Bearer unlesbar. PFLICHT,
# zufaellig erzeugen (z. B. openssl rand -base64 32); leer bricht `docker compose` ab,
# ein Platzhalter wird in Production beim Start abgewiesen.
CHESSABLE_API_URL=http://piratechess-api:8080
CHESSABLE_SERVICE_KEY=

# false schaltet den RookHub-EIGENEN Chessable-Weg ab (Bearer hinterlegen, Kurs-Import,
# naechtlicher Kurslisten-Refresh); /api/chessable/* antwortet dann 404. Der Weg ueber die
# RepCheck-EXTENSION (/api/extension/*) bleibt unberuehrt. Leer/unset = an.
CHESSABLE_ENABLED=
ENCRYPTION_KEY=

# Optional: Claude-API-Key — NUR fuer das Formular-Einlesen (Foto -> Partie, Kostenbremse im Code).
# Leer lassen = Feature inaktiv. Schluessel: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: EIGENER Schluessel fuer die Text-Aufrufe (Puzzle-Tipps, Kommentar-Uebersetzung). Bewusst getrennt:
# ohne diesen Schluessel laufen Tipps und Uebersetzung NICHT ueber den Konto-Schluessel oben (seit 2026-09-25).
ANTHROPIC_TEXT_API_KEY=

# Optional: GitHub-PAT (actions:read auf die beteiligten Repos) fuer den Admin-Tab "CI / Actions".
# Leer lassen -> Tab zeigt nur einen Hinweis. Fine-grained PAT empfohlen.
GITHUB_TOKEN=

# Discord-Verknuepfung: HMAC-Secret fuer signierte Link-Tokens. MUSS exakt mit dem
# schach-bot (ROOKHUB_LINK_SECRET) uebereinstimmen. Leer lassen -> Feature inaktiv
# (ein Platzhalter „change_me…" ebenso). Eigener Zufallswert, NICHT derselbe wie unten.
DISCORD_LINK_SECRET=

# Schach-Bot Stats-Endpoint (/api/bot/player-progress): HMAC-Secret, mit dem der Bot
# den Trainings-/Puzzle-Fortschritt verknuepfter Spieler fuer den Motivations-DM liest.
# MUSS exakt mit dem schach-bot (ROOKHUB_STATS_SECRET) uebereinstimmen. Leer -> Endpoint aus
# (ein Platzhalter „change_me…" ebenso). Eigener Zufallswert, NICHT derselbe wie oben.
SCHACH_BOT_STATS_SECRET=

# Basis-URL des Frontends — fuer absolute Links in E-Mails (z.B. Passwort-Reset).
# In Produktion auf die oeffentliche Adresse setzen.
APP_BASE_URL=https://rookhub.oberschmid.homes
# Eigene Domain der Turnierseite (Link-Vorschau geteilter Turnier-Links).
TURNIER_BASE_URL=https://turnier.oberschmid.homes
# Eigene Domains von KidHub und LeagueHub: dorthin fuehrt der Passwort-Reset-Link, wenn dort
# „Passwort vergessen" geklickt wurde (leer = Link auf APP_BASE_URL).
KIDHUB_BASE_URL=https://kidhub.oberschmid.homes
LEAGUEHUB_BASE_URL=https://leaguehub.oberschmid.homes

# E-Mail-Versand (Passwort-Reset). EMAIL_SMTP_HOST leer lassen -> Versand deaktiviert
# (die Mail inkl. Reset-Link wird dann nur ins Log geschrieben). Fuer echten Versand
# einen SMTP-Server hinterlegen. Port 587 = Submission + STARTTLS (empfohlen),
# 25 nur als Fallback, 465 = implizites SSL.
EMAIL_SMTP_HOST=login.trellmor.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=rookhub@oberschmid.homes
EMAIL_SMTP_PASSWORD=change_me_smtp_password
EMAIL_FROM_ADDRESS=rookhub@oberschmid.homes
EMAIL_FROM_NAME=RookHub
EMAIL_USE_STARTTLS=true

# App
ASPNETCORE_ENVIRONMENT=Production

# Ports
API_PORT=5001
FRONTEND_PORT=8086
TURNIER_PORT=8093
KIDHUB_PORT=8096
LEAGUEHUB_PORT=8100
CLUBHUB_PORT=8102
# Bind-Adressen der Ports (leer = Vorgabe). API_BIND leer = 127.0.0.1: nur der Host. Gehen Schach-Bot
# oder Reverse-Proxy direkt auf API_PORT, eine Host-Adresse setzen — nie 0.0.0.0. FRONTEND_BIND
# leer = 0.0.0.0 fuer alle Oberflaechen; kommt der Reverse-Proxy ueber die LAN-Adresse, genuegt diese.
# HIER BEWUSST LEER (Vorlage, siehe KIBANA_BIND). Auf DIESEM Host in der echten `.env`:
# API_BIND=10.24.13.6 (Schach-Bot, leaguehub-nginx und NPM-Proxy-Host 22 gehen auf 10.24.13.6:5001)
# und FRONTEND_BIND=10.24.13.6.
# RESTRISIKO dieser LAN-Adresse: Sie schliesst nur 192.168.1.2 und die Docker-Bridges. Das LAN
# 10.24.12.0/23 und das geroutete VPN 10.8.0.0/24 kommen genau ueber 10.24.13.6 an und erreichen die
# API damit weiter direkt, an NPM und seinen Sperren vorbei. Eine Ziel-Adress-Bindung ist KEIN
# Quell-Filter; den gibt es nur per Regel in der iptables-Kette DOCKER-USER (siehe KIBANA_BIND).
# Option ohne LAN-Listener (enger, aber ebenfalls kein Quell-Filter): API_BIND=172.17.0.1, das
# docker0-Gateway (= host.docker.internal fuer Container; so lauscht ES seit 2026-09-04 zusaetzlich).
# Vorher Schach-Bot, leaguehub-nginx (upstream rookhub_api) und NPM-Proxy-Host 22 von
# 10.24.13.6:5001 auf 172.17.0.1:5001 umstellen.
# FALLE: Die Port-Kurzform bindet genau EINE Adresse. Mit API_BIND=10.24.13.6 (oder 172.17.0.1)
# faellt der 127.0.0.1-Listener weg; Host-Werkzeuge mit Loopback-Vorgabe bekommen dann
# „connection refused" und brauchen die URL als Argument:
#   scripts/gazetteer-import.sh, directory-runs.sh, directory-backfill.sh, classify-directory.sh
#     -> erstes Argument, z. B. bash scripts/gazetteer-import.sh http://10.24.13.6:5001
#   scripts/import_books.py -> --api-url http://10.24.13.6:5001
# Wer 127.0.0.1 zusaetzlich braucht, ergaenzt im api-Dienst einen zweiten Port-Eintrag
# "127.0.0.1:${API_PORT}:8080" (mehrere Adressen = mehrere Eintraege, wie bei ES).
API_BIND=
FRONTEND_BIND=

# VPN (Gluetun / WireGuard)
VPN_SERVICE_PROVIDER=airvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_private_key_here
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=10.x.x.x/32
SERVER_COUNTRIES=Germany
FIREWALL_VPN_INPUT_PORTS=8080

# Elasticsearch + Kibana
ES_PORT=9202
KIBANA_PORT=5601
# Admin-UI: Link zur passenden Kibana/ES-Konsole DIESER Umgebung (Admin-Header).
# Leer lassen -> Link bleibt versteckt. Prod-Kibana:
KIBANA_URL=http://10.24.13.6:5601

# --- Web-Push (VAPID) — optional; alle drei leer = Push deaktiviert ---
# Keypair erzeugen (z. B. web-push CLI: `npx web-push generate-vapid-keys`).
WEBPUSH_SUBJECT=
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=

# --- CI-Push-Modell (Admin-Tab „CI / Actions") — optional; leer = Endpoints antworten 401 ---
# CI_BUILD_REPORT_SECRET  : gemeinsames Geheimnis für `POST /api/ci/build-report`; genau dieser Wert
#                           steht im log-watcher bzw. im GitHub-Actions-Secret, das den Report sendet.
# CI_GITHUB_WEBHOOK_SECRET: Secret des GitHub-`workflow_run`-Webhooks.
CI_BUILD_REPORT_SECRET=
CI_GITHUB_WEBHOOK_SECRET=

# Elasticsearch laeuft ohne Security: wer den Port erreicht, darf LESEN UND SCHREIBEN. Dieselbe
# Adress-Wahl wie bei KIBANA_BIND (leer/unset = 127.0.0.1). In DIESEM Compose ist ES gar nicht
# veroeffentlicht — die Variable steht hier nur, damit sie nicht uebersehen wird, wenn jemand den
# Port aufmacht (compose.dev*.yml nutzen sie bereits).
ES_BIND=

# Kibana laeuft ohne Login (xpack.security.enabled=false), deshalb NUR die Adressen
# veroeffentlichen, ueber die es erreichbar sein soll — leer/unset = 127.0.0.1 (nur der Host).
# Entscheidung 2026-09-04 fuer diesen Host: die LAN-Adresse von ens18. Deren Maske /23 deckt
# 10.24.12.0-10.24.13.255 ab, also das ganze 10.24.12.x/13.x-Netz; die zweite Adresse derselben
# Netzkarte (192.168.1.2) bleibt damit zu. Nur-Host ist die Vorgabe (Zugang dann per
# ssh -L 5601:127.0.0.1:5601 <host>).
# Auch geroutete Netze (hier das VPN 10.8.0.0/24, das hinter dem Gateway terminiert) erreichen
# Kibana damit: ihre Pakete kommen auf ens18 mit ZIEL 10.24.13.6 an. Wer hier auf 127.0.0.1
# verengt, sperrt sie mit aus.
# ACHTUNG: Das ist eine Ziel-Adress-Bindung, KEIN Quell-Filter — wer 10.24.13.6 routen kann, kommt
# durch. Eine echte Beschraenkung auf ein Quell-Netz braucht eine Regel in der iptables-Kette
# DOCKER-USER (veroeffentlichte Container-Ports umgehen INPUT).
# HIER BEWUSST LEER: Das ist eine VORLAGE. Eine fest eingetragene fremde LAN-Adresse laesst
# `docker compose up` auf jedem anderen Host mit „bind: cannot assign requested address"
# scheitern. Auf DIESEM Host lautet der Wert in der echten `.env`: KIBANA_BIND=10.24.13.6
KIBANA_BIND=

# Die beiden naechtlichen Crawl-Laeufe. Leer/true = an (Vorgabe). Auf false schweigt der
# Container nachts, die Admin-Endpunkte bleiben bedienbar — gedacht fuer Dev.
TOURNAMENT_DIRECTORY_ENABLED=true
PLAYER_HISTORY_ENABLED=true
