<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Diagramm-Erkennung als Kommandozeilenprogramm (0.870.0) fuer externe Diagramm-Worker (Laptop, /api/diagram-worker).
    Nutzt DENSELBEN Erkennungscode wie der Server (Verweis auf das API-Projekt: Extraktoren, eingebettete ONNX-Netze);
    KEIN Teil des API-Images. Windows-Build (eigenstaendig, ohne installiertes .NET):
      dotnet publish -c Release -r win-x64 (eigenstaendig, Version = APP_VERSION) — Befehl in docs/api/ebooks.md
    Scans brauchen pdftoppm + pdfinfo (Poppler) im PATH oder per poppler-Ordner.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RookHub.Tools.DiagramCli</RootNamespace>
    <AssemblyName>rookhub-diagrams</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/api/RookHub.Api/RookHub.Api.csproj" />
  </ItemGroup>

  <!-- Einstellungen der API gehören nicht ins Programm (sie kämen über den Projektverweis mit). -->
  <Target Name="DropApiSettings" AfterTargets="Publish">
    <Delete Files="$(PublishDir)appsettings.json;$(PublishDir)appsettings.Development.json;$(PublishDir)RookHub.Api.staticwebassets.endpoints.json;$(PublishDir)RookHub.Api.exe;$(PublishDir)RookHub.Api" />
  </Target>

</Project>
