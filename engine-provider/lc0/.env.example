# --- Verbindung zu RookHub (wie beim Stockfish-Container) -----------------------------------------
ROOKHUB_URL=https://rookhub.oberschmid.homes
# Im RookHub-Profil unter „API-Tokens" mit Scope „Engine" anlegen:
ROOKHUB_API_TOKEN=rkh_...

# --- Engines ----------------------------------------------------------------------------------------
# Der Name IST die Registrierung — auf jedem Rechner eigene Namen, sonst kapern sie sich gegenseitig.
ENGINE_PRIMARY_NAME=RookHub Spark Lc0
ENGINE_BACKGROUND_NAME=RookHub Spark Lc0 Hintergrund
# Lc0 rechnet auf der GPU, nicht auf Kernen: EINE Live-Engine nutzt die GPU allein gut aus. Mehrere
# Prozesse teilen sich dieselbe GPU (jeder lädt das Netz einmal, BT4 ≈ 0,4 GB fp16). Vorgabe 0 —
# warum, steht in der README unter „Tiefe".
ENGINE_BACKGROUND_COUNT=0
# Threads = Such-Threads von Lc0 (füttern die GPU), keine CPU-Kerne. Der Zwischenschalter deckelt
# auf LC0_MAX_THREADS.
ENGINE_PRIMARY_MAX_THREADS=2
ENGINE_BACKGROUND_MAX_THREADS=2
# Hash hat Lc0 nicht; der Wert wird angenommen und verworfen (RookHub schickt ihn trotzdem).
ENGINE_PRIMARY_MAX_HASH=1024
ENGINE_BACKGROUND_MAX_HASH=1024

# --- Lc0 --------------------------------------------------------------------------------------------
# cuda-fp16 = schnell auf Blackwell; cuda = fp32 (Fehlersuche); blas = CPU (nur zum Prüfen, langsam).
LC0_BACKEND=cuda-fp16
# Eigenes Netz: Datei per Volume einhängen und hier den Pfad im Container nennen.
# LC0_WEIGHTS=/opt/lc0/net/default.pb.gz
LC0_MAX_THREADS=2
# Weitere Lc0-Schalter, z. B. größerer Zwischenspeicher (Einträge, nicht MB) oder Batchgröße:
# LC0_ARGS=--nncache=2000000 --minibatch-size=256

# --- Zeitplan ---------------------------------------------------------------------------------------
# Wann wie viel gerechnet wird — dieselbe Angabe wie beim Stockfish-Container (dort steht die lange
# Erklärung in der .env.example). Leer = immer alles. 0 % schaltet die Engines ganz ab, dazwischen
# bleibt die Live-Engine an und der Anteil gilt den Hintergrund-Engines. Auf einer GPU ist das auch
# eine Strom- und Wärmefrage, nicht nur eine der Kerne.
#
#   ENGINE_SCHEDULE=Mo-Fr 08:00-18:00 0%; * 18:00-08:00 100%
#
# Prüfen: docker compose run --rm -e ENGINE_SCHEDULE_AT="Mo 09:00" engine-provider-lc0
ENGINE_SCHEDULE=
# background (Vorgabe) = Live-Engine bleibt an, der Anteil gilt den Hintergrund-Engines; all = allen.
ENGINE_SCHEDULE_SCOPE=
