# Kopie als `.env.lichess` anlegen und ausfüllen: cp .env.lichess.example .env.lichess
#
# DIESE DATEI = DER ZWEITE CONTAINER ÜBER LICHESS (Cloud-Anbieter, das Analysebrett von lichess.org).
# Start:  docker compose --profile lichess up -d --build     (der erste Container, .env, spricht direkt
# mit RookHub; beide laufen nebeneinander, dauerhaft mit COMPOSE_PROFILES=lichess in der .env)
#
# KEIN ROOKHUB_URL in dieser Datei: seine Anwesenheit schaltet den Container auf den direkten Weg um.

# Lichess-API-Token mit den Scopes engine:read UND engine:write.
# Der Provider REGISTRIERT die Engine auf deinem Lichess-Konto, dafür reicht read allein nicht.
# Anlegen: https://lichess.org/account/oauth/token/create?scopes[]=engine:read&scopes[]=engine:write
LICHESS_API_TOKEN=

# Anzeigename der Engine — der Provider erkennt seine Registrierung am NAMEN (gleich = Aktualisierung,
# verschieden = zusätzlicher Eintrag). Er darf so heißen wie im direkten Container (zwei Server, zwei
# Registrierungen). Liegt der Lichess-Token zusätzlich im RookHub-Profil, steht die Engine dort zweimal —
# ein Zusatz wie „(Lichess)" hält die beiden Einträge auseinander.
ENGINE_NAME=RookHub Heim-Engine (Lichess)

# Rechenkerne für die Analyse. Leer = alle Kerne des HOSTS — beim Arbeitsrechner lieber 1-2 Kerne frei lassen.
MAX_THREADS=

# Hash-Tabelle in MiB (Obergrenze, die angefragt werden darf). Leer = 512.
MAX_HASH=

# Sekunden, die ein unbenutzter Engine-Prozess weiterläuft, bevor er beendet wird. Leer = 300.
KEEP_ALIVE=

# Logstufe: debug | info | warning | error | critical. Leer = info.
LOG_LEVEL=

# Sekunden Pause zwischen den Starts der Provider, wenn mehrere Engines laufen (leer = 3; 0 = aus).
# Jeder Provider registriert sich beim Start bei lichess.org — 13 auf einmal hielt der DDoS-Schutz
# von Lichess für einen Angriff (2026-09-11: 429, dann IP-Sperre, keine Engine registriert).
PROVIDER_START_DELAY=

# Eigene Engine-Binärdatei (z. B. das UCI-Tunnel-Binary eines Cloud-Anbieters); Volume in der compose.yml
# einhängen. Leer = /opt/stockfish/stockfish.
ENGINE_PATH=

# MEHRERE ENGINES: dasselbe Schema wie in .env.example (ENGINE_PRIMARY_*, ENGINE_BACKGROUND_*,
# ENGINE_BACKGROUND_COUNT). Über Lichess aber SPARSAM: der DDoS-Schutz von Lichess drosselt je IP — acht
# Provider auf einer Maschine gehen, zwölf nicht (2026-09-11: IP-Sperre). Hintergrund-Engines gehören in den
# direkten Container; hier genügt meist die eine Live-Engine.
#ENGINE_BACKGROUND_COUNT=2
