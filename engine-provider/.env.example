# Kopie als `.env` anlegen und ausfüllen: cp .env.example .env

# PFLICHT: Lichess-API-Token mit den Scopes engine:read UND engine:write.
# Der Provider REGISTRIERT die Engine auf deinem Lichess-Konto, dafür reicht read allein nicht.
# Anlegen: https://lichess.org/account/oauth/token/create?scopes[]=engine:read&scopes[]=engine:write
LICHESS_API_TOKEN=

# Anzeigename der Engine — genau so erscheint sie in der RookHub-Auswahl.
# Der Provider erkennt seine Registrierung am NAMEN: gleich bleibt = Aktualisierung beim
# Neustart, verschieden = zusätzlicher Eintrag. Auf zwei Rechnern zwei Namen vergeben.
ENGINE_NAME=RookHub Heim-Engine

# Rechenkerne für die Analyse. Leer = alle Kerne des HOSTS (der Provider zählt die Kerne
# der Maschine, nicht ein Docker-CPU-Limit) — beim Arbeitsrechner lieber 1-2 Kerne frei lassen.
MAX_THREADS=

# Hash-Tabelle in MiB (Obergrenze, die RookHub anfragen darf). Leer = 512.
MAX_HASH=

# Sekunden, die ein unbenutzter Engine-Prozess weiterläuft, bevor er beendet wird. Leer = 300.
KEEP_ALIVE=

# Sekunden Schweigen im Analyse-Stream, nach denen ein Lebenszeichen (Leerzeile) rausgeht, damit
# Broker/CDN die stumme Verbindung nicht schliessen. Leer = 15; 0 schaltet es ab.
HEARTBEAT_SECONDS=

# Logstufe: debug | info | warning | error | critical. Leer = info.
LOG_LEVEL=

# Eigene Engine-Binärdatei statt des mitgelieferten Stockfish 18 (z. B. ein auf die eigene
# CPU optimierter Build oder das UCI-Tunnel-Binary eines Cloud-Anbieters). Dann in der
# compose.yml zusätzlich das passende Volume einhängen. Leer = /opt/stockfish/stockfish.
ENGINE_PATH=

# NUR für einen späteren RookHub-eigenen Broker (heute nicht nötig, leer lassen):
# LICHESS_URL=
# BROKER_URL=

# ===========================================================================
# MEHRERE ENGINES IN DIESEM CONTAINER
#
# Je Engine ein eigener Stockfish-Prozess und eine eigene Registrierung bei Lichess. Die
# Aufteilung ist immer dieselbe: VORNE eine Live-Engine mit vielen Threads, weil dort ein Mensch
# auf EINE Stellung wartet, DAHINTER mehrere Hintergrund-Engines mit wenigen, weil dort der
# Durchsatz zählt. Gemessen (8 Kerne, Tiefe 20, 5 Linien): eine Suche wird von 1 auf 8 Threads
# nur um den Faktor 1,13 schneller, VIER Suchen nebeneinander um fast das Dreifache. Details in
# der README unter „Für Analyse-Aufträge: VIELE Engines mit WENIGEN Threads".
#
# ENGINE_BACKGROUND_COUNT leer = eine einzelne Engine wie früher.
# ===========================================================================

# --- Die HAUPT-Engine für die Live-Analyse (immer genau eine) --------------
# Sie behält alle Kerne: hier zählt die Zeit bis zum Ergebnis, nicht der Durchsatz. RookHub
# pausiert die Hintergrund-Engines, sobald sie rechnet.
ENGINE_PRIMARY_NAME=RookHub Server
ENGINE_PRIMARY_MAX_THREADS=8
ENGINE_PRIMARY_MAX_HASH=4096

# --- Die HINTERGRUND-Engines (alle gleich eingestellt) ---------------------
# Zwei Threads sind das gemessene Optimum; mehr Engines schlagen mehr Threads.
# ACHTUNG NAME: die erste heißt genau ENGINE_BACKGROUND_NAME, die zweite "<Name> 2", die dritte
# "<Name> 3" … Der Name IST die Identität der Lichess-Registrierung — wird er geändert, entsteht
# eine NEUE Engine mit neuer Kennung, und die Hintergrund-Auswahl im RookHub-Profil zeigt ins Leere.
ENGINE_BACKGROUND_NAME=RookHub Server Hintergrund
ENGINE_BACKGROUND_MAX_THREADS=2
ENGINE_BACKGROUND_MAX_HASH=1024

# --- Wie viele Hintergrund-Engines? ----------------------------------------
# Faustregel: so viele, dass ENGINE_BACKGROUND_COUNT × ENGINE_BACKGROUND_MAX_THREADS die Kerne
# des Containers (cpus: in der compose.yaml) knapp füllt. Mehr als zwölf bringen nichts, solange
# RookHub je Partie höchstens zwölf Aufträge gleichzeitig offen hält. Jede kostet zusätzlich ihre
# eigene Hashtabelle (ENGINE_BACKGROUND_MAX_HASH) an Arbeitsspeicher.
ENGINE_BACKGROUND_COUNT=4

# Die früheren Namen dieser sieben Zeilen (LIVE_NAME/LIVE_MAX_THREADS/LIVE_MAX_HASH,
# BACKGROUND_NAME/BACKGROUND_MAX_THREADS/BACKGROUND_MAX_HASH, BACKGROUND_COUNT) gelten weiterhin
# als Rückfall — eine bestehende .env läuft unverändert weiter. Stehen beide da, gewinnt ENGINE_*.

# Das ältere Schema (ENGINE_COUNT + ENGINE_<i>_NAME/_MAX_THREADS/_MAX_HASH) gilt weiterhin und
# schlägt die Werte von oben. Gebraucht nur für Engines, die aus der Reihe fallen sollen.
#ENGINE_3_MAX_THREADS=4
