# Kopie als `.env` anlegen und ausfüllen: cp .env.example .env

# PFLICHT: Lichess-API-Token mit den Scopes engine:read UND engine:write.
# Der Provider REGISTRIERT die Engine auf deinem Lichess-Konto, dafür reicht read allein nicht.
# Anlegen: https://lichess.org/account/oauth/token/create?scopes[]=engine:read&scopes[]=engine:write
LICHESS_API_TOKEN=

# Anzeigename der Engine — genau so erscheint sie in der RookHub-Auswahl.
# Der Provider erkennt seine Registrierung am NAMEN: gleich bleibt = Aktualisierung beim
# Neustart, verschieden = zusätzlicher Eintrag. Auf zwei Rechnern zwei Namen vergeben.
ENGINE_NAME=RookHub Heim-Engine

# Rechenkerne für die Analyse. Leer = alle Kerne des HOSTS (der Provider zählt die Kerne
# der Maschine, nicht ein Docker-CPU-Limit) — beim Arbeitsrechner lieber 1-2 Kerne frei lassen.
MAX_THREADS=

# Hash-Tabelle in MiB (Obergrenze, die RookHub anfragen darf). Leer = 512.
MAX_HASH=

# Sekunden, die ein unbenutzter Engine-Prozess weiterläuft, bevor er beendet wird. Leer = 300.
KEEP_ALIVE=

# Sekunden Schweigen im Analyse-Stream, nach denen ein Lebenszeichen (Leerzeile) rausgeht, damit
# Broker/CDN die stumme Verbindung nicht schliessen. Leer = 15; 0 schaltet es ab.
HEARTBEAT_SECONDS=

# Logstufe: debug | info | warning | error | critical. Leer = info.
LOG_LEVEL=

# Eigene Engine-Binärdatei statt des mitgelieferten Stockfish 18 (z. B. ein auf die eigene
# CPU optimierter Build oder das UCI-Tunnel-Binary eines Cloud-Anbieters). Dann in der
# compose.yml zusätzlich das passende Volume einhängen. Leer = /opt/stockfish/stockfish.
ENGINE_PATH=

# NUR für einen späteren RookHub-eigenen Broker (heute nicht nötig, leer lassen):
# LICHESS_URL=
# BROKER_URL=

# Mehrere Engines in DIESEM Container (je ein eigener Stockfish-Prozess, je eine Registrierung bei
# Lichess). Typischer Fall: "1" = Live-Analyse, "2" = Hintergrund-Aufträge, die RookHub pausiert,
# sobald Live rechnet — deshalb dürfen BEIDE alle Kerne bekommen. Namen werden zu
# "<ENGINE_NAME> 1", "<ENGINE_NAME> 2", … — oder je Engine per ENGINE_<i>_NAME überschreiben.
# Ebenso ENGINE_<i>_MAX_THREADS / ENGINE_<i>_MAX_HASH (sonst gelten MAX_THREADS / MAX_HASH).
# Leer/1 = eine Engine wie bisher. Maximal 16.
ENGINE_COUNT=
#ENGINE_1_NAME=RookHub Server Live
#ENGINE_2_NAME=RookHub Server Hintergrund
#ENGINE_2_MAX_HASH=8192
